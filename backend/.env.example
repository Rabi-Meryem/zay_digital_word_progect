# Copier ce fichier en "backend/.env" (non versionné) — valeurs pour le DEV LOCAL
# uniquement, alignées sur docker-compose.yml. Ne jamais utiliser en production.

SECRET_KEY=dev-secret-key-a-changer
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (service "postgres" du docker-compose.yml)
DB_NAME=zay_db
DB_USER=postgres
DB_PASSWORD=zay1234
DB_HOST=localhost
DB_PORT=5432

# Redis (service "redis")
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# MinIO (service "minio") — stockage des pièces jointes
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=admin123456
AWS_STORAGE_BUCKET_NAME=zay-tickets

# Service IA (optionnel pour l'instant, valeur par défaut)
AI_SERVICE_URL=http://localhost:8001
